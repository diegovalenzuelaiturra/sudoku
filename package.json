{
  "name": "sudoku",
  "version": "0.0.0",
  "private": true,
  "description": "Tests for the sudoku page. The site is static, has no runtime dependencies, and ships from the repo root; nothing in here is published.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "prek run --all-files",
    "lint:biome": "biome check",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix && biome check --write",
    "lint:oxlint": "oxlint",
    "lint:spelling": "cspell --config cspell.config.mjs --no-progress",
    "preview": "node scripts/build.mjs && node e2e/static-server.mjs",
    "test": "node --test --test-timeout=30000",
    "test:coverage": "node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=88 --test-coverage-functions=90",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cspell/dict-es-es": "^3.0.9",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@j178/prek": "^0.5.7",
    "@playwright/test": "^1.64.1",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.88.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.88.0",
    "terser": "^5.51.2"
  }
}
